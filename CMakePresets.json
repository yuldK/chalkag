{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 2,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "windows-common",
            "hidden": true,
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/bin",
            "cacheVariables": {
                "CMAKE_SYSTEM_VERSION": "10.0.22621.0",
                "LUIL_ENABLE_DIRECT3D": "OFF",
                "LUIL_ENABLE_WEBVIEW": "OFF"
            }
        },
        {
            "name": "vs2026",
            "displayName": "Visual Studio 2026 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 18 2026"
        },
        {
            "name": "vs2022",
            "displayName": "Visual Studio 2022 x64",
            "inherits": "windows-common",
            "generator": "Visual Studio 17 2022"
        }
    ],
    "buildPresets": [
        {
            "name": "vs2026-debug",
            "configurePreset": "vs2026",
            "configuration": "Debug",
            "targets": ["chalkag"]
        },
        {
            "name": "vs2026-release",
            "configurePreset": "vs2026",
            "configuration": "Release",
            "targets": ["chalkag"]
        },
        {
            "name": "vs2022-debug",
            "configurePreset": "vs2022",
            "configuration": "Debug",
            "targets": ["chalkag"]
        },
        {
            "name": "vs2022-release",
            "configurePreset": "vs2022",
            "configuration": "Release",
            "targets": ["chalkag"]
        }
    ]
}
